[Unit]
Description=RAG Web
After=network.target

[Service]
Type=simple
User=rag
WorkingDirectory=/opt/rag-web
Environment=OLLAMA_BASE=http://127.0.0.1:11434/v1
Environment=OLLAMA_MODEL=qwen2.5:7b
ExecStart=/opt/rag-web/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
